<?xml version="1.0"?>
<launch>
    <!-- Joystick node -->
    <!-- autorepeat_rate: Частота автоматического повторения событий джойстика (Hz) 
         когда кнопка/ось удерживается. Значение 20.0 означает 20 событий в секунду -->
    <!-- coalesce_interval: Интервал для объединения событий джойстика (сек).
         События в пределах этого интервала объединяются для уменьшения нагрузки -->
    <node name="joystick" pkg="joy" type="joy_node" output="screen">
        <param name="dev" type="string" value="/dev/input/js0"/>
        <param name="autorepeat_rate"   type="double" value="20.0"/>
        <param name="coalesce_interval" type="double" value="0.05"/>
    </node>

    <!-- Robot control node -->
    <!-- Все параметры (robot_id, port, baudrate) загружаются из конфигурационных файлов:
         - robot_id: config/game.yaml
         - port, baudrate: config/serial.yaml -->
    <node name="joystick_control" pkg="ainex_peripherals" type="joystick_control.py" output="screen" />
</launch>
